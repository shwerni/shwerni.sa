enum ArticleState {
  PUBLISHED
  HOLD
  HIDDEN
}

model Article {
  id         String        @id @default(cuid())
  aid        Int           @unique @default(autoincrement())
  status     ArticleState
  image      String
  title      String
  article    String        @db.Text
  category   Categories
  likes      ArticleLike[]
  created_at DateTime      @default(now())
  read       Int           @default(0)

  // @relations
  consultantId    Int?
  consultant      Consultant?        @relation(fields: [consultantId], references: [cid])
  specialties     ArticleSpecialty[]
  articleComments ArticleComment[]

  @@map("articles")
}

model ArticleLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // @relations
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([articleId, userId])
  @@map("article_likes")
}

model ArticleComment {
  id         String       @id @default(cuid())
  comment    String
  name       String
  status     CommentState @default(HOLD)
  rate       Float
  author     String?
  created_at DateTime     @default(now())

  // @relations
  articleId Int
  article   Article @relation(fields: [articleId], references: [aid], onDelete: Cascade)

  consultantId Int?
  consultant   Consultant? @relation(fields: [consultantId], references: [cid], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([articleId])
  @@index([consultantId])
  @@map("article_comments")
}

model ArticleSpecialty {
  articleId   String
  specialtyId String

  // Relations
  article   Article   @relation(fields: [articleId], references: [id])
  specialty Specialty @relation(fields: [specialtyId], references: [id])

  @@id([articleId, specialtyId])
  @@map("article_specialties")
}
