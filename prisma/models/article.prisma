enum ArticleState {
  PUBLISHED
  HOLD
  HIDDEN
}

model Article {
  id         String        @id @default(cuid())
  aid        Int           @unique @default(autoincrement())
  status     ArticleState
  image      String
  title      String
  article    String        @db.Text
  category   Categories
  likes      ArticleLike[]
  created_at DateTime      @default(now())
  // the last content change (title, body, image, faqs): written explicitly by whoever edits the
  // article. not @updatedAt: the dashboard edits with raw sql (prisma never sees it) and the
  // view counter (read) would otherwise move it on every page view
  updated_at DateTime?
  read       Int           @default(0)

  // @relations
  consultantId    Int?
  consultant      Consultant?        @relation(fields: [consultantId], references: [cid])
  specialties     ArticleSpecialty[]
  articleComments ArticleComment[]
  faqs            ArticleFaq[]

  @@map("articles")
}

// the article page's faq section: questions people search for, answered from the article.
// shown under the article body and in the page's FAQPage json-ld; no pages or urls of their own
model ArticleFaq {
  id         String   @id @default(cuid())
  question   String
  answer     String   @db.Text
  // display order, ascending
  order      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // @relations
  articleAid Int
  article    Article @relation(fields: [articleAid], references: [aid], onDelete: Cascade)

  @@index([articleAid, order])
  @@map("article_faqs")
}

model ArticleLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // @relations
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([articleId, userId])
  @@map("article_likes")
}

model ArticleComment {
  id         String       @id @default(cuid())
  comment    String
  name       String
  status     CommentState @default(HOLD)
  rate       Float
  author     String?
  created_at DateTime     @default(now())

  // @relations
  articleId Int
  article   Article @relation(fields: [articleId], references: [aid], onDelete: Cascade)

  consultantId Int?
  consultant   Consultant? @relation(fields: [consultantId], references: [cid], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([articleId])
  @@index([consultantId])
  @@map("article_comments")
}

model ArticleSpecialty {
  articleId   String
  specialtyId String

  // Relations
  article   Article   @relation(fields: [articleId], references: [id])
  specialty Specialty @relation(fields: [specialtyId], references: [id])

  @@id([articleId, specialtyId])
  @@map("article_specialties")
}
